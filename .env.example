# ==============================================================================
# TimeSwap — Environment Variable Configuration
# ==============================================================================
# Note: Never commit secrets (.env, .env.local) to version control.
# Copy this file to .env.local for local development.

# ------------------------------------------------------------------------------
# Supabase Configuration (Public Client)
# ------------------------------------------------------------------------------
# Replace with your local Supabase instance or remote Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Replace with your Supabase anonymous public key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ------------------------------------------------------------------------------
# Supabase Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Service role key with administrative privileges.
# STRICT SECURITY WARNING: NEVER prefix with NEXT_PUBLIC_ or expose to the browser!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
